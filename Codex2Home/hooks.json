{
  "description": "Codex2Home lifecycle hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${CODEX_HOME:-$HOME/.codex}/hooks/rules-context.sh\"; [ -f \"$H\" ] || exit 0; sh \"$H\"",
            "timeout": 10,
            "statusMessage": "rules-context",
            "additionalContextLimit": 40000
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${CODEX_HOME:-$HOME/.codex}/hooks/project-context.sh\"; [ -f \"$H\" ] || exit 0; sh \"$H\"",
            "timeout": 10,
            "statusMessage": "project-context",
            "additionalContextLimit": 20000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|write_file|edit_file|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${CODEX_HOME:-$HOME/.codex}/hooks/route-guard.sh\"; [ -f \"$H\" ] || exit 0; sh \"$H\"",
            "timeout": 10,
            "statusMessage": "route-guard"
          }
        ]
      }
    ]
  }
}
