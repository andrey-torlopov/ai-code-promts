{
  "permissions": {
    "allow": [
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(awk *)",
      "Bash(sed -n *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(ruby -c *)",
      "Bash(ruby -ryaml *)",
      "Bash(python3 -c *)",
      "mcp__acp__Write",
      "mcp__acp__Edit",
      "mcp__acp__Bash"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${CLAUDE_PROJECT_DIR:-.}/_ai/hooks/skill-lint.sh\"; [ -f \"$H\" ] || exit 0; sh \"$H\"",
            "timeout": 10,
            "statusMessage": "skill-lint"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${CLAUDE_PROJECT_DIR:-.}/_ai/hooks/skill-context-lint.sh\"; [ -f \"$H\" ] || exit 0; sh \"$H\" \"${CLAUDE_PROJECT_DIR:-.}\"",
            "timeout": 10,
            "statusMessage": "skill-context-lint"
          }
        ]
      }
    ]
  }
}
